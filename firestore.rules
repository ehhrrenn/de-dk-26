rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // No auth, no allowlist -- this trip site is intentionally public.
    // Only names are stored for travelers (no passport/DOB/etc.), so
    // there's nothing sensitive gated behind these rules.
    match /days/{dayId} {
      allow read, write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /travelers/{travelerId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
