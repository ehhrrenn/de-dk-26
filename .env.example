# Copy this file to .env.local and fill in values from your Firebase project
# (Project settings -> General -> Your apps -> SDK setup and configuration).
# These are client-side identifiers, not secrets -- it's normal and expected
# for them to end up in the built JS bundle. Real access control lives in
# firestore.rules, not in hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps API key -- used to render the interactive trip map (Maps
# JavaScript API for the map itself, Geocoding API for place-name pins like
# saved restaurants/tents that only have a text query, not lat/lon). Requires
# a Google Cloud project with billing enabled (Maps Platform). Enable both
# "Maps JavaScript API" and "Geocoding API" on this key in APIs & Services >
# Library. Restrict it by HTTP referrer to your Firebase Hosting domain (and
# localhost for local dev) in the Cloud console -- it's a public client-side
# identifier, same as the Firebase config above. (Kept as
# VITE_GOOGLE_MAPS_STATIC_KEY for compatibility with the existing GitHub
# Actions secret name -- Maps Static API is no longer used by the app and can
# be left enabled or disabled, your call.)
VITE_GOOGLE_MAPS_STATIC_KEY=
